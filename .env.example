# REBUSS OPS — Variáveis de Ambiente para Produção / Netlify
# Cadastre estas variáveis no painel da Netlify:
# Site configuration > Environment variables > Add a variable

# 1. URL de Conexão com o Banco de Dados PostgreSQL na Nuvem
# Exemplo (Supabase / Neon / Railway / Render / AWS RDS):
DATABASE_URL="postgresql://usuario:senha@seu-host-postgresql.com:5432/rebuss_ops?sslmode=require"

# 2. Chave Secreta para Assinatura de Tokens JWT
JWT_SECRET="rebuss_ops_super_secret_jwt_key_prod_2026"

# 3. Administrador Inicial (Criado automaticamente na primeira execução)
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL="admin@rebuss.com"
INITIAL_ADMIN_PASSWORD="sua_senha_segura_aqui"

# 4. (Opcional) Porta para desenvolvimento local
PORT=3001
