# REBUSS OPS — Variáveis de Ambiente para Produção / Supabase / Netlify
# Cadastre estas variáveis diretamente no painel da Netlify:
# Site configuration > Environment variables > Add a variable

# 1. SUPABASE TRANSACTION POOLER (Obrigatória na Netlify — Runtime/Functions)
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection string > URI (Transaction / Port 6543)
DATABASE_URL=your-supabase-transaction-pooler-url

# 2. SUPABASE DIRECT CONNECTION (Opcional — usada pelo Prisma CLI / Migrations)
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection string > URI (Direct / Port 5432)
DIRECT_URL=your-supabase-direct-url

# 3. JWT SECRET (Obrigatória na Netlify — Runtime/Functions)
# Chave secreta de alta entropia para assinatura dos tokens de autenticação
JWT_SECRET=your-jwt-secret-here

# 4. ADMIN INICIAL (Opcional — Runtime/Functions)
# Cria automaticamente o primeiro usuário administrador se o banco estiver vazio
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=your-admin-password-here

# 5. CONFIGURAÇÕES LOCAIS (Opcional — apenas desenvolvimento local)
PORT=3001
DB_POOL_MAX=4
